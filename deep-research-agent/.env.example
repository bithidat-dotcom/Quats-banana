####################################################################
# Deep Research Agent — environment variables
# Copy this file to `.env.local` and fill in at least ONE LLM key and
# ONE search key.  Nothing here is ever sent to the browser.
####################################################################

# ---------- LLM providers (at least one) ----------
# Google Gemini (default provider)
GEMINI_API_KEY=
# OpenAI (also used for any OpenAI-compatible endpoint when DR_OPENAI_BASE_URL is set)
OPENAI_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=

# Optional: point the "openai-compatible" provider at a custom gateway
# (Azure OpenAI, Groq, Together, vLLM, Ollama, LM Studio, ...).
# DR_OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ---------- Search providers (at least one) ----------
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# ---------- Defaults for the UI ----------
DR_DEFAULT_PROVIDER=gemini            # gemini | openai | anthropic | openrouter | openai-compatible | demo
DR_DEFAULT_MODEL=gemini-2.5-flash
DR_DEFAULT_DEPTH=standard             # quick | standard | deep

# ---------- Guard rails ----------
DR_RATE_LIMIT_MAX=12                  # research requests per window, per IP
DR_RATE_WINDOW_MS=600000              # window length in ms (10 minutes)
DR_MAX_CONCURRENT=2                   # concurrent researches per IP
DR_MAX_STEPS_MULTIPLIER=1             # scale every step/search/page budget (handy for local testing)
DR_ENABLE_DEMO=1                      # set to 0 to hide the offline demo provider
DR_MAX_PAGE_BYTES=6291456             # max bytes downloaded per page (6 MB)
